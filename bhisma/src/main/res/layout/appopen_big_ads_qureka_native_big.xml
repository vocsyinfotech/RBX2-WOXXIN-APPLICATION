<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ad_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">


    <RelativeLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginStart="70dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/appopen_designs">

        <ImageView
            android:id="@+id/app_icon"
            android:layout_width="30dp"
            android:layout_height="40dp"
            android:layout_marginStart="10dp"
            android:padding="2dp"
            android:src="@drawable/applogo" />

        <TextView
            android:id="@+id/app_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="8dp"
            android:layout_toRightOf="@id/app_icon"
            android:text="@string/as"
            android:textColor="#000"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/continue_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_marginEnd="40dp"
            android:layout_centerVertical="true"
            android:text="Continue to App"
            android:textColor="#000"
            android:textSize="10sp" />
        <ImageView
            android:id="@+id/close_button"
            android:layout_width="40dp"
            android:layout_alignParentEnd="true"
            android:layout_height="40dp"
            android:padding="10dp"
            android:src="@drawable/baseline_close_24" />

        <TextView
            android:id="@+id/timer_count"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:layout_alignParentEnd="true"
            android:text="2"
            android:textColor="#000"
            android:textSize="10sp" />
    </RelativeLayout>

    <View
        android:id="@+id/vvv"
        android:layout_width="match_parent"
        android:layout_height="10dp"
        android:layout_below="@+id/topBar"
        android:background="@color/black" />

    <LinearLayout
        android:id="@+id/QurekaAds_native"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/vvv"
        android:background="@color/white"
        android:orientation="vertical"
        android:padding="10dp">

        <!-- Ad Label -->
        <TextView
            android:id="@+id/ad_notification_view"
            android:layout_width="100dp"
            android:layout_height="wrap_content"
            android:background="@drawable/ads_button_chage"
            android:backgroundTint="#DFDFDF"
            android:gravity="center"
            android:padding="5dp"
            android:paddingHorizontal="4dp"
            android:text="Advertisement"
            android:textColor="#464646"
            android:textSize="10dp" />

        <!-- Big Icon -->
        <pl.droidsonroids.gif.GifImageView
            android:id="@+id/gifimagview"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="50dp"
            android:src="@drawable/applogo" />

        <!-- Heading -->
        <TextView
            android:id="@+id/description"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="20dp"
            android:text="Play Cricket Win Coins"
            android:textColor="#000000"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Sub Heading -->
        <TextView
            android:id="@+id/shortdiscrip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="2dp"
            android:text="Play &amp; Win Diamond💎"
            android:textColor="#000000"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- Description -->
        <TextView
            android:id="@+id/description_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="4dp"
            android:visibility="gone"
            android:text="Win 1,00,000 Diamonds💎 &amp; More"
            android:textColor="#000000"
            android:textSize="12sp" />

        <!-- Banner Image -->
        <ImageView
            android:id="@+id/imagview"
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:layout_marginTop="40dp"
            android:scaleType="fitCenter" />

        <!-- Play Now Button -->
        <TextView
            android:id="@+id/actionbutton"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="25dp"
            android:layout_marginBottom="41dp"
            android:background="@drawable/ads_button_chage"
            android:fontFamily="@font/poppins_bold"
            android:gravity="center"
            android:text="PLAY NOW"
            android:textColor="#ffffff"
            android:textSize="16sp" />

    </LinearLayout>


</RelativeLayout>
