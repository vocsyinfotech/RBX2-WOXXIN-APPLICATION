<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/ad_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:background="#4E4E4E">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.facebook.ads.MediaView
            android:id="@+id/native_ad_media"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/lightTransparent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@+id/native_ad_title"
            app:layout_constraintStart_toStartOf="@+id/native_ad_title"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/native_ad_body"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginBottom="2dp"
            android:ellipsize="end"
            android:fontFamily="@font/inter_regular"
            android:maxLines="2"
            android:textColor="@color/white"
            android:textSize="@dimen/_13sdp"
            app:layout_constraintBottom_toTopOf="@+id/native_ad_title"
            app:layout_constraintEnd_toEndOf="@+id/native_ad_title"
            app:layout_constraintStart_toEndOf="@+id/ad_notification_view" />

        <TextView
            android:id="@+id/ad_notification_view"
            style="@style/AppTheme.Ads"
            android:layout_gravity="center_vertical"
            android:layout_marginBottom="2dp"
            android:paddingHorizontal="@dimen/_5sdp"
            android:paddingLeft="@dimen/_5sdp"
            android:paddingRight="@dimen/_5sdp"
            app:layout_constraintBottom_toBottomOf="@+id/native_ad_body"
            app:layout_constraintStart_toStartOf="@+id/native_ad_title"
            app:layout_constraintTop_toTopOf="@+id/native_ad_body" />

        <TextView
            android:id="@+id/native_ad_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="3dp"
            android:layout_marginLeft="3dp"
            android:layout_marginRight="3dp"
            android:layout_marginBottom="10dp"
            android:fontFamily="@font/inter_regular"
            android:maxLines="3"
            android:text="@string/appbar_scrolling_view_behavior"
            android:textColor="@color/white"
            android:textSize="@dimen/_10sdp"
            app:layout_constraintBottom_toTopOf="@+id/native_ad_call_to_action"
            app:layout_constraintEnd_toEndOf="@+id/native_ad_call_to_action"
            app:layout_constraintStart_toStartOf="@+id/native_ad_call_to_action" />

        <TextView
            android:id="@+id/native_ad_call_to_action"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_marginHorizontal="15dp"
            android:layout_marginLeft="15dp"
            android:layout_marginRight="15dp"
            android:layout_marginBottom="15dp"
            android:background="@drawable/ads_button_chage"
            android:gravity="center"
            android:text="Install"
            android:textColor="@color/colorWhite"
            android:textSize="@dimen/_12sdp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</RelativeLayout>
