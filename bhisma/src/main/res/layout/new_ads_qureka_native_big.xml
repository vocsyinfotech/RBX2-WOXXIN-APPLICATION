<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ad_view"
    android:layout_width="match_parent"

    android:layout_height="wrap_content"
    android:background="@drawable/main_card_bg"

    >

    <!--    <TextView-->
    <!--        android:id="@+id/ad_notification_view"-->
    <!--        android:layout_width="wrap_content"-->
    <!--        android:layout_height="wrap_content"-->
    <!--        android:layout_alignParentRight="true"-->
    <!--        android:layout_marginLeft="10dp"-->
    <!--        android:layout_marginRight="10dp"-->
    <!--        android:visibility="gone"-->
    <!--        android:background="@color/app_color"-->
    <!--        android:gravity="center"-->
    <!--        android:paddingHorizontal="2dp"-->
    <!--        android:paddingLeft="2dp"-->
    <!--        android:paddingRight="2dp"-->
    <!--        android:text="AD"-->
    <!--        android:textColor="@color/white"-->
    <!--        android:textSize="10dp" />-->

    <LinearLayout
        android:id="@+id/QurekaAds_native"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:orientation="vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="3dp"
            android:paddingHorizontal="4dp"
            android:paddingBottom="3dp">

            <pl.droidsonroids.gif.GifImageView
                android:id="@+id/gifimagview"
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:layout_gravity="center"
                android:layout_marginStart="2dp"
                android:layout_marginLeft="2dp"
                android:scaleType="fitCenter" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_weight="1"
                android:gravity="center"
                android:layout_marginStart="15dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/description"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="top|left"
                    android:gravity="top|left"
                    android:maxLines="2"
                    android:singleLine="true"
                    android:textAllCaps="false"
                    android:textColor="@color/adstextcolor"
                    android:textSize="17dp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="-1dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/shortdiscrip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:hint=""
                        android:lines="1"
                        android:maxLines="2"
                        android:singleLine="true"
                        android:textColor="@color/adstextcolor"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>
            <TextView
                android:id="@+id/ad_notification_view"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_alignParentRight="true"
                android:layout_marginLeft="10dp"
                android:layout_marginRight="10dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/ads_button_chage"
                android:gravity="center"
                android:paddingHorizontal="2dp"
                android:paddingLeft="2dp"
                android:paddingRight="2dp"
                android:text="AD"
                android:textColor="@color/white"
                android:textSize="10dp" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp">

            <ImageView
                android:id="@+id/imageView"
                android:layout_marginHorizontal="5dp"
                android:layout_width="match_parent"
                android:layout_height="150dp"
                android:minHeight="150dp" />
        </FrameLayout>



        <TextView
            android:id="@+id/actionbutton"
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:layout_marginHorizontal="5dp"
            android:layout_marginTop="4dp"

            android:layout_marginBottom="14dp"
            android:background="@drawable/ads_button_chage"
            android:backgroundTint="#9C27B0"
            android:fontFamily="@font/poppins_bold"
            android:gravity="center"
            android:lines="1"
            android:textColor="#ffffff"
            android:textSize="15dp" />
    </LinearLayout>
</RelativeLayout>
