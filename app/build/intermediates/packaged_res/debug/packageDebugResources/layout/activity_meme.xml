<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_primary">

    <!-- Toolbar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="@color/bg_surface"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="8dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_back_arrow"
            android:tint="@color/gold"
            android:contentDescription="Back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Memes 😂"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginStart="4dp" />

        <!-- Counter badge -->
        <TextView
            android:id="@+id/tvMemeCounter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1 / 8"
            android:textColor="@color/gold"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginEnd="4dp" />

        <!-- Share button -->
        <ImageButton
            android:id="@+id/btnShare"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_share"
            android:tint="@color/gold"
            android:contentDescription="Share" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/bg_divider" />

    <!-- ViewPager2 — swipeable meme images -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPagerMeme"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/bg_surface_raised" />

    <!-- Bottom panel -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/bg_surface"
        android:paddingTop="12dp"
        android:paddingBottom="16dp"
        android:paddingHorizontal="16dp">

        <!-- Dot indicator -->
        <LinearLayout
            android:id="@+id/dotsContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp" />

        <!-- Caption -->
        <TextView
            android:id="@+id/tvMemeCaption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Caption"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:gravity="center"
            android:lineSpacingMultiplier="1.3"
            android:layout_marginBottom="16dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/bg_divider"
            android:layout_marginBottom="12dp" />

        <!-- Action row: Prev | Like | Share | Next -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <!-- Prev -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnPrevMeme"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="◀ Prev"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:background="@drawable/btn_spin_now"
                android:stateListAnimator="@null" />

            <!-- Like -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnLike"
                android:layout_width="56dp"
                android:layout_height="48dp"
                android:layout_marginEnd="6dp"
                android:text="❤"
                android:textSize="18sp"
                android:background="@drawable/btn_spin_now"
                android:stateListAnimator="@null" />

            <!-- Next -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnNextMeme"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="Next ▶"
                android:textColor="@color/gold"
                android:textSize="13sp"
                android:textStyle="bold"
                android:background="@drawable/btn_spin_now"
                android:stateListAnimator="@null" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
