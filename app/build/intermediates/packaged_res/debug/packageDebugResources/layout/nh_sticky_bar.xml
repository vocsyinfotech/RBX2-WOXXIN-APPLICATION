<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/mainLayout" android:layout_width="match_parent" android:layout_height="wrap_content">
    <FrameLayout android:id="@+id/sticky_barLeft" android:background="@drawable/round_corner_left" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="50dp" android:layout_alignParentLeft="true" android:layout_alignParentBottom="true" android:layout_centerInParent="true" android:transformPivotX="100dp" android:transformPivotY="100dp" android:rotation="-90" android:layoutDirection="ltr">
        <LinearLayout android:gravity="center" android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="match_parent">
            <ImageView android:layout_gravity="center" android:id="@+id/newsHub_icon" android:layout_width="30dp" android:layout_height="30dp" android:scaleType="fitCenter" android:contentDescription="@string/todo" android:layoutDirection="ltr" android:layout_marginStart="20dp"/>
            <TextView android:textSize="18dp" android:textStyle="bold" android:gravity="center" android:id="@+id/news_hub_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:singleLine="true" android:layoutDirection="ltr" android:layout_marginStart="10dp" android:layout_marginEnd="20dp"/>
        </LinearLayout>
    </FrameLayout>
    <FrameLayout android:id="@+id/sticky_barRight" android:background="@drawable/round_corner_right" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="50dp" android:layout_alignParentRight="true" android:layout_alignParentBottom="true" android:layout_centerVertical="true" android:transformPivotX="100dp" android:transformPivotY="100dp" android:rotation="-90" android:layoutDirection="ltr">
        <LinearLayout android:gravity="center" android:orientation="horizontal" android:layout_width="wrap_content" android:layout_height="match_parent">
            <ImageView android:layout_gravity="center" android:id="@+id/newsHub_icon1" android:layout_width="30dp" android:layout_height="30dp" android:scaleType="fitCenter" android:contentDescription="@string/todo" android:layoutDirection="ltr" android:layout_marginStart="20dp"/>
            <TextView android:textSize="18dp" android:textStyle="bold" android:gravity="center" android:id="@+id/news_hub_title1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:singleLine="true" android:layoutDirection="ltr" android:layout_marginStart="10dp" android:layout_marginEnd="20dp"/>
        </LinearLayout>
    </FrameLayout>
</RelativeLayout>
