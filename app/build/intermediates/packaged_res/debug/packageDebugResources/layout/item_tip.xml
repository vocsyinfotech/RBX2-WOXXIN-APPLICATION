<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="5dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="@color/bg_surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="18dp"
        android:gravity="center_vertical">

        <!-- Gold circle icon background -->
        <FrameLayout
            android:layout_width="40dp"
            android:layout_height="40dp">
            <View android:layout_width="40dp" android:layout_height="40dp"
                android:background="@drawable/circle_gold_ring"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="💡"
                android:textSize="18sp"
                android:gravity="center" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvTipTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:text="Tip Title"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="›"
            android:textSize="22sp"
            android:textColor="@color/gold" />
    </LinearLayout>
</androidx.cardview.widget.CardView>
