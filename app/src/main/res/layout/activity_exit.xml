<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="#F5F5F5"
    android:padding="32dp">

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="👋" android:textSize="64sp" android:layout_marginBottom="16dp"/>

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Exit App?" android:textSize="24sp" android:textStyle="bold"
        android:textColor="#212121" android:layout_marginBottom="8dp"/>

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Are you sure you want to exit?" android:textSize="15sp"
        android:textColor="#666666" android:gravity="center" android:layout_marginBottom="32dp"/>

    <Button android:id="@+id/btnYesExit" android:layout_width="match_parent" android:layout_height="52dp"
        android:layout_marginBottom="12dp" android:text="Yes, Exit" android:textSize="16sp"
        android:backgroundTint="#E53935"/>

    <Button android:id="@+id/btnNoExit" android:layout_width="match_parent" android:layout_height="52dp"
        android:text="No, Stay" android:textSize="16sp"
        android:backgroundTint="@color/theme_color"/>
</LinearLayout>
