<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/splash_gradient"
    android:fitsSystemWindows="true">

    <!-- HERO: hex coin + character stacked at center -->
    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center">

        <!-- Hex coin backdrop -->
        <ImageView
            android:layout_width="320dp"
            android:layout_height="320dp"
            android:layout_gravity="center"
            android:src="@drawable/splash_coin"
            android:alpha="0.9"
            android:importantForAccessibility="no" />

        <!-- Character mascot (hero) -->
        <ImageView
            android:layout_width="260dp"
            android:layout_height="408dp"
            android:layout_gravity="center"
            android:src="@drawable/splash_character"
            android:contentDescription="Coin Craft mascot"
            android:adjustViewBounds="true" />
    </FrameLayout>

    <!-- TOP: title block -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="72dp"
        android:orientation="vertical"
        android:gravity="center">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Coin Craft"
            android:textColor="@color/gold"
            android:textSize="52sp"
            android:textStyle="bold"
            android:letterSpacing="-0.02"
            android:shadowColor="@color/gold_20"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="24" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="RBX CALCULATOR"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:letterSpacing="0.28" />
    </LinearLayout>

    <!-- BOTTOM: tagline + spinner -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="80dp"
        android:orientation="vertical"
        android:gravity="center">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Play · Win · Earn RBX Daily"
            android:textColor="@color/gold"
            android:textSize="14sp"
            android:letterSpacing="0.12" />

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginTop="28dp"
            android:indeterminateTint="@color/gold" />
    </LinearLayout>

</FrameLayout>
