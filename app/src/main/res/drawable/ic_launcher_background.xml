<?xml version="1.0" encoding="utf-8"?>
<!-- Coin Craft launcher background — pure black with subtle gold radial glow -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Solid dark base -->
    <path android:fillColor="#0D0D0D"
        android:pathData="M0,0h108v108h-108z"/>

    <!-- Gold radial glow centered behind the coin -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr xmlns:aapt="http://schemas.android.com/aapt" name="android:fillColor">
            <gradient
                android:centerX="54" android:centerY="54"
                android:gradientRadius="60"
                android:type="radial">
                <item android:offset="0.0"  android:color="#47FFD700"/>
                <item android:offset="0.55" android:color="#14FFD700"/>
                <item android:offset="1.0"  android:color="#00FFD700"/>
            </gradient>
        </aapt:attr>
    </path>
</vector>
