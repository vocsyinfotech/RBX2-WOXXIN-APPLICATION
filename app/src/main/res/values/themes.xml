<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.RbxCalculatorRoboxCounter" parent="Theme.MaterialComponents.NoActionBar">
        <!-- Gold as primary -->
        <item name="colorPrimary">@color/gold</item>
        <item name="colorPrimaryVariant">@color/gold_dim</item>
        <item name="colorOnPrimary">@color/text_on_gold</item>
        <item name="colorSecondary">@color/gold</item>
        <item name="colorOnSecondary">@color/text_on_gold</item>

        <!-- Dark backgrounds -->
        <item name="android:colorBackground">@color/bg_primary</item>
        <item name="colorSurface">@color/bg_surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnBackground">@color/text_primary</item>

        <!-- System bars -->
        <item name="android:statusBarColor">@color/bg_primary</item>
        <item name="android:navigationBarColor">@color/bg_primary</item>
        <item name="android:windowLightStatusBar">false</item>

        <!-- TextInputLayout gold accent -->
        <item name="colorControlActivated">@color/gold</item>
        <item name="colorControlHighlight">@color/gold_20</item>
    </style>

    <style name="Theme.TransparentAdOnly" parent="Theme.MaterialComponents.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
    </style>

    <style name="Theme.Transparent" parent="Theme.MaterialComponents.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
    </style>
</resources>
